{
  "sys": {
    "install": "sudo pacman -S --needed --noconfirm",
    "update": "sudo pacman -Syu --noconfirm"
  },

  "pkgs": {
    "package": [
      "flatpak"
    ],
    "flatpak": [],
    "shell": [
      "echo \"Finished -> Arch(Pacman)\"",
      "python packit.py -f packages/examples/arch/arch_aur.json"
    ],
    "ignore": ["cd ~/ && git clone https://aur.archlinux.org/yay.git && cd yay && makepkg -si --noconfirm"]
  }
}
